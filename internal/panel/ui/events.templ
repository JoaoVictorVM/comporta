package ui

import "github.com/JoaoVictorVM/comporta/internal/panel"

templ eventsPage(f panel.Frame, l panel.EventList) {
	<form id="event-filters" method="post" action="/panel/events/filter" hx-post="/panel/events/filter" hx-target="#events-live" class="mb-4 grid grid-cols-1 gap-3 rounded border border-line bg-surface p-4 sm:grid-cols-3">
		<div>
			<label for="event-app" class="mb-1 block text-sm font-medium">App</label>
			<select id="event-app" name="app" class="w-full rounded border border-line px-3 py-2">
				@appOptions(f.Apps, l.Filters.App)
			</select>
		</div>
		<div>
			<label for="event-type" class="mb-1 block text-sm font-medium">Type</label>
			<select id="event-type" name="type" class="w-full rounded border border-line px-3 py-2">
				<option value="">All types</option>
				for _, t := range panel.EventTypes {
					<option value={ string(t.Type) } selected?={ string(t.Type) == l.Filters.Type }>{ t.Label }</option>
				}
			</select>
		</div>
		<div class="flex items-end">
			<button type="submit" class="w-full rounded bg-brand px-4 py-2 font-semibold text-white hover:opacity-90">Filter</button>
		</div>
	</form>
	<p id="events-notice" hidden class="mb-2 rounded bg-warn-bg p-2 text-sm text-warn">
		New events available. <button type="button" data-live-apply="events-live" class="font-semibold underline">Show them</button>
	</p>
	<section id="events-live" data-live-scope="events" data-live-hold="true" data-live-notice="events-notice" hx-post="/panel/events/filter" hx-include="#event-filters" hx-trigger="live-refresh" aria-live="polite">
		@eventsBody(l)
	</section>
}

templ eventsBody(l panel.EventList) {
	if l.Invalid {
		<p role="alert" class="rounded bg-bad-bg p-3 text-bad">Invalid filter.</p>
	} else if len(l.Rows) == 0 {
		@empty("No events yet. Loop cuts, fallbacks, blocks, configuration changes and pauses appear here.")
	} else {
		@scrollRegion("Events") {
			<table class="w-full text-left text-sm">
				<caption class="sr-only">Events, newest first</caption>
				<thead class="bg-canvas">
					<tr>
						<th scope="col" class="px-3 py-2">Time</th>
						<th scope="col" class="px-3 py-2">Type</th>
						<th scope="col" class="px-3 py-2">App</th>
						<th scope="col" class="px-3 py-2">Details</th>
						<th scope="col" class="px-3 py-2">Request</th>
					</tr>
				</thead>
				<tbody>
					for _, e := range l.Rows {
						<tr class="border-t border-line align-top">
							<td class="whitespace-nowrap px-3 py-2"><time datetime={ iso(e.At) }>{ stamp(e.At) }</time></td>
							<th scope="row" class="px-3 py-2 font-semibold">{ e.Label }</th>
							<td class="px-3 py-2">{ orDash(e.App) }</td>
							<td class="px-3 py-2">
								<ul>
									for _, d := range e.Details {
										<li class="break-all">{ d }</li>
									}
									if e.User != "" {
										<li class="font-mono">user { e.User }</li>
									}
								</ul>
							</td>
							<td class="px-3 py-2 font-mono text-xs">
								if e.Request != "" {
									<a href={ eventRequestURL(e) } class="text-brand underline">{ shortID(e.Request) }</a>
								} else {
									-
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		if l.Next != "" {
			<nav aria-label="Pages" class="mt-3 flex gap-3">
				if l.Filters == (panel.EventFilters{}) {
					<a href={ cursorURL(panel.ScreenEvents, l.Next) } class="rounded border border-line bg-surface px-3 py-1">Older</a>
				} else {
					<form method="post" action="/panel/events/filter" hx-post="/panel/events/filter" hx-target="#events-live">
						<input type="hidden" name="app" value={ l.Filters.App }/>
						<input type="hidden" name="type" value={ l.Filters.Type }/>
						<input type="hidden" name="cursor" value={ l.Next }/>
						<button type="submit" class="rounded border border-line bg-surface px-3 py-1">Older</button>
					</form>
				}
			</nav>
		}
	}
}
