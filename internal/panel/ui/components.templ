package ui

import (
	"time"

	"github.com/JoaoVictorVM/comporta/internal/panel"
)

templ card(label string, value string) {
	<div class="rounded border border-line bg-surface p-4">
		<p class="text-sm text-muted">{ label }</p>
		<p class="mt-1 text-xl font-semibold">{ value }</p>
	</div>
}

// bar shows a pressure with its text next to it: color is never the only
// indicator, and an unknown state is grey, never green.
templ bar(label string, p panel.Pressure) {
	<div>
		<div class="flex justify-between gap-2 text-sm"><span>{ label }</span><span>{ pressureText(p) }</span></div>
		<div class="mt-1 h-2 w-full overflow-hidden rounded bg-unknown-bg" aria-hidden="true">
			<div class={ "h-2", barWidth(p), barColor(p) }></div>
		</div>
	</div>
}

templ badge(text string, classes string) {
	<span class={ "inline-block rounded px-2 py-0.5 text-xs font-semibold", classes }>{ text }</span>
}

templ pausedBadge() {
	<span class="inline-block rounded bg-bad px-2 py-0.5 text-xs font-semibold text-white">Paused</span>
}

templ unavailable(what string) {
	<p role="status" class="rounded border border-line bg-warn-bg p-3 text-warn">{ what } temporarily unavailable. Reload to try again.</p>
}

templ notVerifiable() {
	<p role="status" class="rounded border border-line bg-unknown-bg p-3 text-unknown">Limit state cannot be verified right now. It is not shown as available budget.</p>
}

templ empty(text string) {
	<p class="rounded border border-dashed border-line bg-surface p-4 text-muted">{ text }</p>
}

// scrollRegion lets a wide table scroll on its own, named for screen readers,
// so the page itself never scrolls sideways.
templ scrollRegion(label string) {
	<div role="region" aria-label={ label } tabindex="0" class="overflow-x-auto rounded border border-line bg-surface">
		{ children... }
	</div>
}

templ appOptions(apps []string, selected string) {
	<option value="">All apps</option>
	for _, a := range apps {
		<option value={ a } selected?={ a == selected }>{ a }</option>
	}
}

templ limitTable(caption string, rows []panel.LimitRow, now time.Time) {
	@scrollRegion(caption) {
		<table class="w-full text-left text-sm">
			<caption class="sr-only">{ caption }</caption>
			<thead class="bg-canvas">
				<tr>
					<th scope="col" class="px-3 py-2">Limit</th>
					<th scope="col" class="px-3 py-2">Used</th>
					<th scope="col" class="px-3 py-2">Reserved</th>
					<th scope="col" class="px-3 py-2">Ceiling</th>
					<th scope="col" class="px-3 py-2">Unit</th>
					<th scope="col" class="px-3 py-2">Renewal</th>
					<th scope="col" class="px-3 py-2">State</th>
				</tr>
			</thead>
			<tbody>
				for _, l := range rows {
					<tr class="border-t border-line">
						<th scope="row" class="px-3 py-2 font-mono text-xs font-normal">{ l.Name }</th>
						<td class="px-3 py-2">{ l.Used }</td>
						<td class="px-3 py-2">{ l.Reserved }</td>
						<td class="px-3 py-2">{ l.Limit }</td>
						<td class="px-3 py-2">{ l.Unit }</td>
						<td class="px-3 py-2">
							if l.RenewsAt != nil {
								<time datetime={ iso(*l.RenewsAt) }>{ renews(l.RenewsAt, now) }</time>
							} else {
								{ renews(nil, now) }
							}
						</td>
						<td class="min-w-32 px-3 py-2">
							@bar(l.Kind, l.Pressure)
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// pausedBanner names the paused apps in red, with the word Paused so the
// state never depends on color alone.
templ pausedBanner(names []string) {
	<div class="mb-4 rounded bg-bad px-4 py-3 text-white" role="status">
		<p class="font-semibold">Paused apps refuse every request until resumed:</p>
		<ul class="mt-1 flex flex-wrap gap-2">
			for _, name := range names {
				<li><a href={ appURL(name) } class="font-semibold text-white underline">{ name }</a></li>
			}
		</ul>
	</div>
}
