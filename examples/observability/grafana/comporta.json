    {
      "id": 15,
      "type": "bargauge",
      "title": "Budget used and reserved",
      "datasource": {
        "type": "prometheus",
        "uid": "comporta-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "comporta-prometheus"
          },
          "refId": "A",
          "expr": "max by (app, scope, dimension, kind) (comporta_budget_used_ratio{app=~\"$app\"})",
          "legendFormat": "used {{app}} {{scope}} {{dimension}} {{kind}}",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "comporta-prometheus"
          },
          "refId": "B",
          "expr": "max by (app, scope, dimension, kind) (comporta_budget_reserved_ratio{app=~\"$app\"})",
          "legendFormat": "reserved {{app}} {{scope}} {{dimension}} {{kind}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "user_max is the largest ratio of any single user in the current window, never a sum."
    },
