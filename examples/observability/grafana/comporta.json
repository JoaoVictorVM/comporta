      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "comporta-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(comporta_request_duration_seconds_bucket{app=~\"$app\"}[5m])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "comporta-prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(comporta_request_duration_seconds_bucket{app=~\"$app\"}[5m])))",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
