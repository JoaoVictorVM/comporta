    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests/s by app and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "comporta-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "comporta-prometheus"
          },
          "refId": "A",
          "expr": "sum by (app, outcome) (rate(comporta_requests_total{app=~\"$app\",model=~\"$model\"}[1m]))",
          "legendFormat": "{{app}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Logical requests per second over 1 minute windows."
