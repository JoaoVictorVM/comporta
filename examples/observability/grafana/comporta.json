        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "comporta-prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(comporta_cost_microusd_total{app=~\"$app\",model=~\"$model\"}[$__range])) / 1000000",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Estimated cost confirmed by the metering in the selected time range, all attempts included. SQLite stays the source of record."
