{
  "uid": "comporta-overview",
  "title": "Comporta",
  "description": "Requests, latency, estimated cost, tokens, blocks, cache, fallbacks, budgets and telemetry health of one Comporta gateway.",
  "tags": [
    "comporta"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "comporta-prometheus"
        },
        "query": {
          "query": "label_values(comporta_requests_total, app)",
          "refId": "app"
        },
        "definition": "label_values(comporta_requests_total, app)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "comporta-prometheus"
        },
        "query": {
          "query": "label_values(comporta_requests_total{app=~\"$app\"}, model)",
          "refId": "model"
        },
        "definition": "label_values(comporta_requests_total{app=~\"$app\"}, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests (since start)",
      "datasource": {
        "type": "prometheus",
        "uid": "comporta-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "comporta-prometheus"
          },
          "refId": "A",
          "expr": "sum(comporta_requests_total{app=~\"$app\",model=~\"$model\"})",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Logical requests counted by this gateway process. A fallback is one request with several attempts."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Estimated cost in range (USD)",
